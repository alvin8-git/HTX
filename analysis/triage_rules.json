  "_amr_comment": "MEGARes Group -> how to read it. class: acquired | intrinsic | core_essential | regulator | point_mutation | rrna_conserved | efflux_ubiquitous. Only 'acquired' can raise a tier on its own.",
  "amr_classes": {
    "MECA": {
      "class": "acquired",
      "note": "Methicillin resistance. Needs a host organism to be meaningful; requires mecR1/mecI context and culture confirmation."
    },
    "CTX": {
      "class": "acquired",
      "note": "CTX-M extended-spectrum beta-lactamase. Genuinely acquired, plasmid-borne."
    },
    "BLAZ": {
      "class": "acquired",
      "note": "Staphylococcal penicillinase. Near-universal in staphylococci since the 1950s; expected background, not a finding."
    },
    "ERMX": {
      "class": "acquired",
      "note": "23S rRNA methyltransferase, macrolide resistance."
    },
    "ERMC": {
      "class": "acquired",
      "note": "23S rRNA methyltransferase, macrolide resistance."
    },
    "MSRA": {
      "class": "acquired",
      "note": "Macrolide ABC efflux, staphylococcal plasmid-borne."
    },
    "MPHC": {
      "class": "acquired",
      "note": "Macrolide phosphotransferase."
    },
    "LNUA": {
      "class": "acquired",
      "note": "Lincosamide nucleotidyltransferase."
    },
    "FUSB": {
      "class": "acquired",
      "note": "Fusidic acid resistance, plasmid-borne."
    },
    "TETK": {
      "class": "acquired",
      "note": "Tetracycline MFS efflux, plasmid-borne in staphylococci."
    },
    "APH3-DPRIME": {
      "class": "acquired",
      "note": "Aminoglycoside phosphotransferase."
    },
    "APH2-DPRIME": {
      "class": "acquired",
      "note": "Aminoglycoside phosphotransferase."
    },
    "ANT4-PRIME": {
      "class": "acquired",
      "note": "Aminoglycoside nucleotidyltransferase."
    },
    "SAT": {
      "class": "acquired",
      "note": "Streptothricin acetyltransferase."
    },
    "FOSA": {
      "class": "acquired",
      "note": "Fosfomycin thiol transferase; intrinsic in many Gram-negatives."
    },
    "FOLP": {
      "class": "point_mutation",
      "note": "Sulfonamide resistance requires specific dihydropteroate synthase substitutions."
    },
    "BLE": {
      "class": "acquired",
      "note": "Bleomycin resistance protein."
    },
    "ICR": {
      "class": "acquired",
      "note": "Colistin phosphoethanolamine transferase (mcr-like). Verify allele before reporting."
    },
    "ADEJ": {
      "class": "intrinsic",
      "note": "AdeIJK RND efflux pump. Chromosomal and present in essentially every A. baumannii. Resistance requires OVEREXPRESSION (adeN repressor mutation), which DNA presence cannot measure."
    },
    "ADEI": {
      "class": "intrinsic",
      "note": "AdeIJK component. Intrinsic, as ADEJ."
    },
    "ADEK": {
      "class": "intrinsic",
      "note": "AdeIJK component. Intrinsic, as ADEJ."
    },
    "LPXA": {
      "class": "core_essential",
      "note": "First Raetz enzyme of lipid A biosynthesis. A core essential gene in every Gram-negative; presence is the default state, not a resistance signal. Colistin resistance needs a LOSS-OF-FUNCTION variant, which needs depth to call."
    },
    "LPXC": {
      "class": "core_essential",
      "note": "As LPXA."
    },
    "LPXD": {
      "class": "core_essential",
      "note": "As LPXA."
    },
    "MECI": {
      "class": "regulator",
      "note": "Repressor of mecA. Meaningless without mecA - its only function is to switch mecA off. Homologous to blaI and filed under the same MEGARes mechanism, so it cross-maps from a bla operon.",
      "requires": "MECA"
    },
    "BLAI": {
      "class": "regulator",
      "note": "Repressor of blaZ.",
      "requires": "BLAZ"
    },
    "BLAR": {
      "class": "regulator",
      "note": "blaR1 sensor-transducer of the bla operon.",
      "requires": "BLAZ"
    },
    "GYRA": {
      "class": "point_mutation",
      "note": "Fluoroquinolone resistance requires QRDR substitutions. Gene presence is universal - every bacterium has gyrA."
    },
    "PARC": {
      "class": "point_mutation",
      "note": "As GYRA - topoisomerase IV is universal."
    },
    "PARE": {
      "class": "point_mutation",
      "note": "As GYRA."
    },
    "RPOB": {
      "class": "point_mutation",
      "note": "Rifampicin resistance requires RRDR substitutions. rpoB is universal and essential."
    },
    "FUSA": {
      "class": "point_mutation",
      "note": "Fusidic acid resistance requires EF-G substitutions. fusA is universal and essential."
    },
    "TUFAB": {
      "class": "point_mutation",
      "note": "EF-Tu is universal and essential."
    },
    "A16S": {
      "class": "rrna_conserved",
