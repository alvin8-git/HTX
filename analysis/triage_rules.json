    "CARB": {
      "class": "acquired",
      "note": "CARB/PSE-family carbenicillin-hydrolysing class A beta-lactamase. Acquired."
    },
    "QACEDELTA1": {
      "class": "acquired",
      "note": "qacE-delta-1 - a TRUNCATED biocide efflux gene that forms the 3'-conserved segment of CLASS 1 INTEGRONS. Its real value is as an integron marker: where it appears, expect co-mobilised resistance cassettes (see ANT3-DPRIME, SULII)."
    },
    "RPOCL": {
      "class": "point_mutation",
      "note": "Daptomycin resistance requires rpoC substitutions. rpoC is universal and essential; presence means nothing on its own."
    },
    "FABI": {
      "class": "point_mutation",
      "note": "Enoyl-ACP reductase - the triclosan target. Essential fatty-acid synthesis gene present in nearly all bacteria; resistance requires substitutions, not presence."
    },
    "ABAF": {
      "class": "intrinsic",
      "note": "AbaF fosfomycin MFS efflux. Chromosomal and intrinsic in Acinetobacter baumannii."
    },
    "ABAQ": {
      "class": "intrinsic",
      "note": "AbaQ MFS efflux. Chromosomal and intrinsic in A. baumannii."
    },
    "ABUO": {
      "class": "intrinsic",
      "note": "AbuO multi-biocide RND efflux. Chromosomal and intrinsic in A. baumannii."
    },
    "AMVA": {
      "class": "intrinsic",
      "note": "AmvA MFS efflux. Chromosomal and intrinsic in A. baumannii."
    },
    "FOSB": {
      "class": "intrinsic",
      "note": "fosB fosfomycin thiol transferase. Chromosomal and intrinsic in staphylococci and Bacillus."
    },
    "ADEG": {
      "class": "intrinsic",
      "note": "AdeFGH RND efflux pump component. Chromosomal in A. baumannii; resistance requires OVEREXPRESSION, not presence."
    },
    "ADEH": {
      "class": "intrinsic",
      "note": "AdeFGH RND efflux pump component. Chromosomal in A. baumannii; see ADEG."
    },
    "ADET1": {
      "class": "intrinsic",
      "note": "AdeT RND efflux pump component. Chromosomal in A. baumannii."
    },
    "ADET2": {
      "class": "intrinsic",
      "note": "AdeT RND efflux pump component. Chromosomal in A. baumannii."
    },
    "MEXE": {
      "class": "intrinsic",
      "note": "MexEF-OprN RND efflux component. Chromosomal in Pseudomonas; expression-dependent."
    },
    "TETR": {
      "class": "regulator",
      "note": "TetR repressor of tet(A). Without tet(A) in the same sample there is nothing for it to regulate.",
      "requires": "TETA"
    },
    "ADEN": {
      "class": "regulator",
      "note": "AdeN, TetR-family repressor of the AdeIJK efflux pump. THIS IS THE GENE THAT MATTERS: AdeIJK presence is intrinsic and uninformative, but LOSS-OF-FUNCTION in adeN de-represses AdeIJK and IS the resistance mechanism. Presence at good breadth and depth does not prove overexpression - it identifies the target for variant calling, which needs deeper coverage than this assay provides.",
      "requires": "ADEJ",
      "actionable_when_partner": true
    },
    "ADEL": {
      "class": "regulator",
      "note": "AdeL, LysR-family regulator of AdeFGH. Loss-of-function de-represses AdeFGH and causes the resistance; presence alone does not.",
      "requires": "ADEG",
      "actionable_when_partner": true
    },
    "ADES": {
      "class": "regulator",
      "note": "AdeS sensor kinase of the AdeRS two-component system regulating AdeABC. Gain-of-function substitutions drive AdeABC overexpression; presence alone does not.",
      "actionable_when_partner": true
    },
    "MEXT": {
      "class": "regulator",
      "note": "MexT, LysR-family activator of MexEF-OprN. Variant alleles drive overexpression; presence alone does not.",
      "requires": "MEXE",
      "actionable_when_partner": true
    },
    "RLMH": {
      "class": "core_essential",
      "note": "RlmH is a housekeeping 23S rRNA methyltransferase (m3-pseudouridine, helix 89), not a resistance methylase. MEGARes files it under the same mechanism string as erm, which is why the mechanism map alone gets it wrong."
    },
    "FOSX": {
      "class": "intrinsic",
      "note": "fosX is chromosomal and intrinsic in Listeria monocytogenes and several other Gram-positives; presence is the default state for those hosts."
    },
    "CRPP": {
      "class": "intrinsic",
      "note": "crpP is chromosomal in Pseudomonas aeruginosa; plasmid-borne variants exist but chromosomal is the default."
    }
  },
