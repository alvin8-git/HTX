  "group_thresholds": {
    "_comment": "Overrides for groups where the class default is wrong. Each entry states WHY, so the threshold can be argued with rather than merely obeyed.",
    "CTX": {
      "breadth": 80.0,
      "depth": 5.0,
      "partial_breadth": 55.0,
      "partial_depth": 8.0,
      "why": "CTX-M is an ESBL - a clinically decisive acquired gene, and the CTX-M family is diverse enough that reads from one allele cover a reference allele partially. Missing a real ESBL costs more than over-calling one, so the fragment route is relaxed to 8x. Report as partial: the family is established, the allele is not."
    },
    "MECA": {
      "breadth": 80.0,
      "depth": 5.0,
      "partial_breadth": 55.0,
      "partial_depth": 8.0,
      "why": "Same argument as CTX: methicillin resistance is decisive, and a partial mecA still warrants culture."
    },
    "BLAZ": {
      "breadth": 85.0,
      "depth": 8.0,
      "partial_breadth": 999.0,
      "partial_depth": 999.0,
      "why": "Staphylococcal penicillinase is near-universal background. Raised, and the fragment route disabled, so it does not crowd out real findings."
    }
  },
